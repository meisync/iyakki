# IYAKKI kernel config fragment, applied on top of the kernel's x86_64_defconfig.
# Drivers are modules (=m) unless needed to boot; hardware is matched by modalias at boot
# (iyakki-core::boot::coldplug). Verified against 6.12 by `verify-kernel-config.sh`.

# ---- core / boot -----------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_FW_LOADER=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
# x2APIC with interrupt remapping: firmware on current Intel laptops (Meteor Lake and later, e.g. HP Pavilion 16-af0, 2026-11-07) enables
# x2APIC and can lock the legacy xAPIC off; a kernel without CONFIG_X86_X2APIC then disables the APIC altogether ("Kernel does not
# support x2APIC"), hidden by quiet, and the start stops before stage 1. IRQ_REMAP is what X2APIC depends on (the Intel IOMMU is built in).
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_X86_X2APIC=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_CGROUPS=y
CONFIG_UEVENT_HELPER=y

# ---- filesystems -----------------------------------------------------------
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---- storage ---------------------------------------------------------------
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
# Intel VMD (the "Intel RST/VMD" or RAID mode of HP, Dell and Lenovo Intel laptops since 11th gen): without it the NVMe disk behind the
# VMD bridge is invisible and the installed system stops at "still waiting for the IYAKKI drive". Built in, like the NVMe driver.
CONFIG_VMD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MISC_RTSX_USB=m
CONFIG_MMC_REALTEK_USB=m

# ---- USB / input -----------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_ACPI=m
CONFIG_I2C_HID_CORE=m
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_I2C_I801=m
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_AMD=y

# ---- Ethernet --------------------------------------------------------------
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E100=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGBVF=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_ICE=m
CONFIG_IGC=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=m
CONFIG_8139TOO=m
CONFIG_R8169=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_BNX2X=m
CONFIG_BNXT=m
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL1=m
CONFIG_ATL1C=m
CONFIG_ATL1E=m
CONFIG_ATL2=m
CONFIG_ALX=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=m
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=m
CONFIG_NET_VENDOR_VIA=y
CONFIG_VIA_RHINE=m
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=m
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=m
CONFIG_BROADCOM_PHY=m
CONFIG_MARVELL_PHY=m
CONFIG_MICREL_PHY=m
CONFIG_VITESSE_PHY=m
# USB Ethernet and tethering
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_LAN78XX=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m
CONFIG_USB_NET_SMSC95XX=m
# Two computers joined by ONE cable (`iyakki dev usb`, docs/DEVELOPER-MODE.md): Thunderbolt 3/4 and USB4 networking (the `thunderbolt` module
# and `thunderbolt_net`, which makes the interface thunderbolt0), and host-to-host USB bridge cables with a usbnet driver of their own
# (Prolific PL-2301/2302/25A1/27A1 = plusb, NetChip = net1080, the CDC "subset" links). A plain USB-C cable between two PCs carries no
# network: both ends are USB hosts. Not set: CONFIG_USB4_KUNIT_TEST, CONFIG_USB4_DEBUGFS_WRITE (test and debug only).
CONFIG_USB4=m
CONFIG_USB4_NET=m
CONFIG_USB_NET_PLUSB=m
CONFIG_USB_NET_NET1080=m
CONFIG_USB_NET_CDC_SUBSET=m
# virtualisation guests
CONFIG_VIRTIO_NET=y
CONFIG_VMXNET3=m
CONFIG_HYPERV_NET=m
CONFIG_NET_FAILOVER=y
# L2/L3 plumbing
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TUN=y
# Settings -> Network -> VPN: WireGuard, configured by IYAKKI over generic netlink (crates/iyakki-vpn). A module, loaded when the first
# profile is enabled; selects the ChaCha20-Poly1305/Curve25519 library code and NET_UDP_TUNNEL. GPL-2.0 kernel code, source via legal-info/.
CONFIG_WIREGUARD=m
CONFIG_VETH=m
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=m
CONFIG_MACVLAN=m

# ---- WiFi ------------------------------------------------------------------
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_CARL9170=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CE=m
CONFIG_RTL8192CU=m
CONFIG_RTL8723BE=m
CONFIG_RTL8821AE=m
CONFIG_RTL8XXXU=m
CONFIG_RTW88=m
CONFIG_RTW88_PCI=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW89=m
CONFIG_RTW89_PCI=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8851BE=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT76_CORE=m
CONFIG_MT76x0U=m
CONFIG_MT76x0E=m
CONFIG_MT76x2E=m
CONFIG_MT76x2U=m
CONFIG_MT7915E=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_B43=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800PCI=m
CONFIG_RT73USB=m
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_PCIE=m
CONFIG_MWIFIEX_USB=m
# crypto used by mac80211 for WPA2/WPA3 (CCMP, GCMP, CMAC/GMAC, SAE helpers)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_ECB=y
# ---- encrypted per-person home folders (F-STORE-05, docs/development/DATA-VOLUME-ENCRYPTION.md) ---------------------
# A container file on the data volume is attached to a loop device and mapped through dm-crypt (aes-xts-plain64, 4096-byte
# sectors) when the person signs in; the key goes in through the device-mapper ioctl (iyakki-storage::dm), no cryptsetup.
# Built in (=y), not modules: nothing may depend on a module being loaded at the moment of sign-in. Added 2026-11-09, NOT yet built.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_MICHAEL_MIC=m

# ---- Bluetooth (kernel side; no userland stack shipped) ---------------------
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_INTEL=m
CONFIG_BT_RTL=m
CONFIG_BT_BCM=m
CONFIG_BT_MTK=m
# /dev/uhid: IYAKKI's own Bluetooth keyboard/mouse/game pad support (iyakki-devctl bthid) feeds the reports it reads from the
# device into the kernel through uhid (F-NET-18). Takes effect with the next kernel build.
CONFIG_UHID=m

# ---- graphics (DRM/KMS; userspace GBM/Mesa not included) ---------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_QXL=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_HYPERV=m
# GPU compute and ordinary PCs (docs/GPU-K3S.md; alpha.2). Turing/Ampere need the GSP firmware path of nouveau (Ada always uses it);
# without GSP_DEFAULT it takes nouveau.config=NvGspRm=1 on the kernel line. HSA_AMD is the kernel side of AMD ROCm (F-GPU-02, stage 2,
# nothing user-visible yet: it costs about 150 KB). The NVIDIA open modules (package/nvidia-open) are built against this kernel and need
# DRM, MMU_NOTIFIER and HMM_MIRROR, which are already on.
CONFIG_DRM_NOUVEAU_GSP_DEFAULT=y
CONFIG_HSA_AMD=y
# Newer Intel laptops and desktops: GPIO/pin control and the I2C controller of the touchpad, idle states.
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_INTEL_IDLE=y

# ---- audio / video capture ---------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_VIRTIO=m
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m

# ---- platform / reliability ----------------------------------------------------
CONFIG_ACPI=y
# ---- laptop battery and charger (docs/BATTERY.md): the shell's battery indicator reads /sys/class/power_supply -------------
# Without CONFIG_ACPI_BATTERY a laptop's ACPI battery device (PNP0C0A) has no driver and no BAT0 appears (seen on a 2020 MacBook
# Pro: only the AC adapter showed up). Built in, so no module loading is needed. ACPI_PROCFS_POWER is the old /proc interface: off.
CONFIG_PM=y
# ---- sleep (the Sleep choice on the power cards): /sys/power/state offers freeze (s2idle) and mem only with these. ACPI_SLEEP
# has no prompt: it turns on by itself on x86 with ACPI and SUSPEND, so it is not listed. Hibernate is left off.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_POWER_SUPPLY=y
CONFIG_POWER_SUPPLY_HWMON=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_SBS=y
# CONFIG_ACPI_PROCFS_POWER is not set
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_X86_INTEL_PSTATE=y
# no governor daemon runs: without this the CPU can sit at its lowest speed and the whole UI feels slow
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=m
CONFIG_HW_RANDOM_AMD=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_WATCHDOG=y
CONFIG_SOFT_WATCHDOG=m
CONFIG_ITCO_WDT=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_NVME_HWMON=y
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_HYPERV=m
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=m

# ---- memory: compressed swap in RAM (zram), see docs/ZRAM-AND-INSTALL.md ------------------------------------------
# iyakki-core sets /dev/zram0 up at boot (boot.rs, iyakki-zram). Built in, so it works before any module loads.
# Compressors: zstd (default), lz4, lzo-rle (kept as the fallback), all built in.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
# zswap (optional second tier in front of a swap file; off unless iyakki.zswap=on)
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
# memory pressure figures (/proc/pressure/memory) for the SYSTEM tile
CONFIG_PSI=y

# ---- hardening ---------------------------------------------------------------
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SECCOMP=y
CONFIG_SECURITY=y

# ---- containers: what k3s (the local container cluster) needs ----------------
# The memory controller is required by the kubelet; BPF is how cgroup v2 limits device access.
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y
CONFIG_USER_NS=y
CONFIG_OVERLAY_FS=y
# the lean boot layout's root image (docs/BOOT-SPEED.md): a zstd squashfs on the boot volume, read lazily through a loop device
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_VXLAN=m
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_NETIFACE=m
CONFIG_IP_SET_BITMAP_PORT=m
# nftables: the iptables that k3s carries talks to the kernel through it
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_HASH=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y

# ---- Secure Boot (docs/SECURE-BOOT.md): the kernel can run under shim + a Machine Owner Key -------------------------------
# With Secure Boot OFF none of this changes anything: modules (signed or not) load, nothing is locked. With Secure Boot ON the
# kernel locks itself down (integrity mode; stock 6.12 does not do this by itself, so patches-sb/ adds the few lines every distribution carries) and only loads modules signed by a key the person
# enrolled as a MOK: shim hands the MOK list to the kernel, which puts it in the ".machine" keyring, linked to the secondary
# trusted keyring that module signatures are checked against. Modules are signed at image build time with the owner's key
# (dist/buildroot/secureboot.sh), NOT by the kernel build (MODULE_SIG_ALL stays off, so a build without a key is plain).
# MODULE_SIG_FORCE stays off on purpose: driver packs (wl.ko) must keep loading with Secure Boot off; under lockdown the kernel
# refuses unsigned modules by itself.
CONFIG_MODULE_SIG=y
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_SIG_SHA256=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY is not set
CONFIG_SYSTEM_BLACKLIST_KEYRING=y
CONFIG_SECONDARY_TRUSTED_KEYRING=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
CONFIG_INTEGRITY_PLATFORM_KEYRING=y
CONFIG_INTEGRITY_MACHINE_KEYRING=y
CONFIG_LOAD_UEFI_KEYS=y
