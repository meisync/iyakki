# IYAKKI live ISO / bare-metal image, x86_64, BIOS + UEFI, hybrid (dd-able to USB).
# "libre" variant: no proprietary firmware blobs. See iyakki_x86_64_hw_defconfig for the blob variant.
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="iyakki"
BR2_TARGET_GENERIC_ISSUE=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.112"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/linux.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
# The one kernel patch every x86-64 image carries: lock the kernel down when Secure Boot is on (docs/SECURE-BOOT.md, BOUNDARY.md
# rule 3). The Mac variant lists this folder again, next to its own (configs/iyakki_mac.fragment).
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/patches-sb"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_DROPBEAR=y
# the SSH client of the CLI tile (ssh, scp, dbclient, dropbearkey): already part of Dropbear, kept on on purpose (docs/CLI-SSH.md)
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_CA_CERTIFICATES=y
# the time zone database (/usr/share/zoneinfo, public domain): every zone for Settings -> Time and correct daylight saving
BR2_PACKAGE_TZDATA=y
BR2_PACKAGE_TZDATA_ZONELIST="default"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_ZSTD=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/grub.cfg"
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BOOT_PARTITION="cd"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat part_msdos part_gpt normal biosdisk iso9660 configfile search search_fs_file search_label all_video vbe vga video video_fb gfxterm gfxterm_background gfxmenu png font gzio test echo"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/grub-pc-builtin.cfg"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat part_msdos part_gpt normal chain efi_gop iso9660 configfile search search_fs_file search_label all_video video video_fb gfxterm gfxterm_background gfxmenu png font gzio test echo"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/grub-efi-builtin.cfg"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/post-image.sh support/scripts/genimage.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_IYAKKI_PATH)/board/iyakki/genimage-install.cfg"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# ---- git (F-GIT-01): the Git tile and the boot self-test (crates/iyakki-agent/src/pathcheck.rs) need the git program in EVERY image, not only the web one.
# A separate GPL-2.0 program run as a process (never linked); HTTPS through git-remote-http(s) (libcurl on OpenSSL); SSH through iyakki-git-ssh.
BR2_PACKAGE_GIT=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_IYAKKI_GIT_SSH=y
