# Appended to the libre defconfig for the "hw" variant. linux-firmware blobs are
# redistributable but NOT open source (see LICENSING.md); only the ones named here ship.
BR2_PACKAGE_LINUX_FIRMWARE=y
# Intel WiFi
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3160=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3168=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_5000=y
