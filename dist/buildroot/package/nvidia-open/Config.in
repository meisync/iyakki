config BR2_PACKAGE_NVIDIA_OPEN
	bool "nvidia-open"
	depends on BR2_LINUX_KERNEL
	depends on BR2_x86_64
	help
	  NVIDIA's open GPU kernel modules (nvidia.ko, nvidia-uvm.ko,
	  nvidia-modeset.ko, nvidia-drm.ko) for Turing and newer GPUs
	  (GTX 16xx, RTX 20/30/40/50 series), built out of tree
	  against the image's own kernel. Dual licence MIT / GPL-2.0.
	  The matching user-space libraries and the GSP firmware are
	  NOT part of this package and not part of any image: the
	  installer downloads them from NVIDIA at the person's click
	  (docs/GPU-K3S.md). Off in every image unless the fragment
	  configs/iyakki_nvidia_open.fragment is appended.

	  https://github.com/NVIDIA/open-gpu-kernel-modules

comment "nvidia-open needs a Linux kernel to be built (x86_64)"
	depends on BR2_x86_64
	depends on !BR2_LINUX_KERNEL
