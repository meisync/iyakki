--- a/patch_cs8409.c
+++ b/patch_cs8409.c
@@ -1442,10 +1442,39 @@
 
 static int patch_cs8409_apple(struct hda_codec *codec);
 
+/* IYAKKI: the codec subsystem ids of Apple machines the Apple code below handles (MacBookPro13,x/14,x, iMac 18,x/19,x). They
+ * are matched before anything else so the Apple code runs whatever the in-tree fixup table does (the Dell table never lists
+ * 0x106b, but a future kernel could), and so the log says which way the codec went. */
+static bool cs8409_is_apple_ssid(u32 ssid)
+{
+	switch (ssid) {
+	case 0x106b3300:	/* MacBookPro13,1 / 14,1 */
+	case 0x106b3600:	/* MacBookPro14,2 */
+	case 0x106b3900:	/* MacBookPro14,3 */
+	case 0x106b0e00:	/* iMac18,1 */
+	case 0x106b0f00:	/* iMac18,2 */
+	case 0x106b1000:	/* iMac18,3 / 19,1 */
+		return true;
+	default:
+		return false;
+	}
+}
+
 static int patch_cs8409(struct hda_codec *codec)
 {
 	int err;
 
+	if (cs8409_is_apple_ssid(codec->core.subsystem_id)) {
+		pr_info("cs8409: Apple path for SSID 0x%08x (PCI SSID %04x:%04x)\n", codec->core.subsystem_id,
+			codec->bus->pci ? codec->bus->pci->subsystem_vendor : 0,
+			codec->bus->pci ? codec->bus->pci->subsystem_device : 0);
+		err = patch_cs8409_apple(codec);
+		pr_info("cs8409: Apple path finished with %d (chip name now \"%s\")\n", err,
+			codec->core.chip_name ? codec->core.chip_name : "?");
+		return err;
+	}
+	pr_info("cs8409: primary (Dell) path for SSID 0x%08x\n", codec->core.subsystem_id);
+
 	if (!cs8409_alloc_spec(codec))
 		return -ENOMEM;
 
