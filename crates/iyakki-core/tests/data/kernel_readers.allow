# One reader per kernel fact. Pairs (kernel path <TAB> source file) that exist today; the list may only shrink (see kernel_single_reader.rs).
# alpha.7 reasons (owner modules, not parsers): iyakki-ui-bin lib.rs only names the default screen device passed to the shell as --fb (it reads nothing);
# iyakki-linuxinit linuxapps_devices.rs is the one owner that picks sound and render device nodes to bind into a Linux-app sandbox (names only, no parsing).
/dev/fb0	crates/iyakki-stage1/src/main.rs
/dev/input	crates/iyakki-apps/src/input.rs
/dev/tty	crates/iyakki-stage1/src/main.rs
/proc/asound	crates/iyakki-shared/src/quiet.rs
/proc/cmdline	crates/iyakki-shared/src/cloudmode.rs
/proc/cmdline	crates/iyakki-stage1/src/main.rs
/proc/mounts	crates/iyakki-storage/src/lib.rs
/proc/net	crates/iyakki-shared/src/devcluster.rs
/proc/net	crates/iyakki-shared/src/k3sdev.rs
/proc/net	crates/iyakki-fw/src/service.rs
/proc/net	crates/iyakki-netscan/src/net.rs
/proc/swaps	crates/iyakki-storage/src/lib.rs
/proc/sys	crates/iyakki-devctl/src/lib.rs
/proc/sys	crates/iyakki-fw/src/service.rs
/proc/sys	crates/iyakki-linuxinit/src/lib.rs
/proc/sys	crates/iyakki-stage1/src/main.rs
/proc/sys	crates/iyakki-storage/src/crashlog.rs
/proc/uptime	crates/iyakki-stage1/src/main.rs
/sys/block	crates/iyakki-storage/src/lib.rs
/sys/class/block	crates/iyakki-stage1/src/main.rs
/sys/firmware	crates/iyakki-usb/src/gpt_install.rs
/sys/firmware	crates/iyakki-usb/src/plan_cli.rs
/dev/fb0	crates/iyakki-ui-bin/src/lib.rs
/dev/dri	crates/iyakki-linuxinit/src/linuxapps_devices.rs
/dev/snd	crates/iyakki-linuxinit/src/linuxapps_devices.rs
