{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "iyakki-sandbox",
          "iyakki.dev/person": "mia",
          "iyakki.dev/run": "nightly-r12",
          "iyakki.dev/team": "web",
          "iyakki.dev/tenant": "acme",
          "iyakki.dev/tier": "job"
        },
        "name": "sbx-nightly-r12",
        "namespace": "web-prod"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ]
          },
          {
            "ports": [
              {
                "port": 3128,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "iyakki-egress"
                  }
                }
              }
            ]
          }
        ],
        "ingress": [],
        "podSelector": {
          "matchLabels": {
            "iyakki.dev/sandbox-run": "sbx-nightly-r12"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "iyakki-sandbox",
          "iyakki.dev/person": "mia",
          "iyakki.dev/run": "nightly-r12",
          "iyakki.dev/team": "web",
          "iyakki.dev/tenant": "acme",
          "iyakki.dev/tier": "job"
        },
        "name": "sbx-nightly-r12",
        "namespace": "web-prod"
      },
      "spec": {
        "activeDeadlineSeconds": 900,
        "backoffLimit": 0,
        "completions": 1,
        "parallelism": 1,
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "iyakki-sandbox",
              "iyakki.dev/person": "mia",
              "iyakki.dev/run": "nightly-r12",
              "iyakki.dev/sandbox-run": "sbx-nightly-r12",
              "iyakki.dev/team": "web",
              "iyakki.dev/tenant": "acme",
              "iyakki.dev/tier": "job"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "command": [
                  "/app/tool",
                  "--once"
                ],
                "env": [
                  {
                    "name": "IYAKKI_FLOW",
                    "value": "nightly"
                  },
                  {
                    "name": "HOME",
                    "value": "/workspace"
                  },
                  {
                    "name": "TMPDIR",
                    "value": "/tmp"
                  },
                  {
                    "name": "HTTP_PROXY",
                    "value": "http://iyakki-egress.web-prod.svc:3128"
                  },
                  {
                    "name": "HTTPS_PROXY",
                    "value": "http://iyakki-egress.web-prod.svc:3128"
                  },
                  {
                    "name": "http_proxy",
                    "value": "http://iyakki-egress.web-prod.svc:3128"
                  },
                  {
                    "name": "https_proxy",
                    "value": "http://iyakki-egress.web-prod.svc:3128"
                  },
                  {
                    "name": "NO_PROXY",
                    "value": "localhost,127.0.0.1"
                  },
                  {
                    "name": "no_proxy",
                    "value": "localhost,127.0.0.1"
                  }
                ],
                "image": "registry.example.com/web/tool:1.2",
                "imagePullPolicy": "IfNotPresent",
                "name": "run",
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "ephemeral-storage": "192Mi",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "ephemeral-storage": "192Mi",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "privileged": false,
                  "readOnlyRootFilesystem": true,
                  "runAsGroup": 10001,
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "volumeMounts": [
                  {
                    "mountPath": "/workspace",
                    "name": "workspace"
                  },
                  {
                    "mountPath": "/tmp",
                    "name": "tmp"
                  }
                ],
                "workingDir": "/workspace"
              }
            ],
            "enableServiceLinks": false,
            "hostIPC": false,
            "hostNetwork": false,
            "hostPID": false,
            "restartPolicy": "Never",
            "runtimeClassName": "gvisor",
            "securityContext": {
              "fsGroup": 10001,
              "runAsGroup": 10001,
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "shareProcessNamespace": false,
            "terminationGracePeriodSeconds": 5,
            "volumes": [
              {
                "emptyDir": {
                  "sizeLimit": "128Mi"
                },
                "name": "workspace"
              },
              {
                "emptyDir": {
                  "sizeLimit": "64Mi"
                },
                "name": "tmp"
              }
            ]
          }
        },
        "ttlSecondsAfterFinished": 600
      }
    }
  ],
  "kind": "List"
}